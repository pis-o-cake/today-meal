# 이 파일을 .env 로 복사해 채운다. .env 는 커밋하지 않는다.

# 앱 서버 주소. 끝에 슬래시를 붙인다.
#   Android 에뮬레이터  http://10.0.2.2:8000/
#   iOS 시뮬레이터      http://localhost:8000/
#   실기기              개발 머신의 LAN 주소. 같은 와이파이에 있어야 한다
API_BASE_URL=http://10.0.2.2:8000/

# Porcupine AccessKey. 콘솔에서 발급한다.
# WARNING: 앱 안의 자격정보는 완전히 비밀이 아니다. 공개 배포 시 관리 방식을 다시 검토한다.
PORCUPINE_ACCESS_KEY=

# 한국어 커스텀 호출어 모델 파일명. assets/wake_word/ 에 둔다.
WAKE_WORD_ASSET=
