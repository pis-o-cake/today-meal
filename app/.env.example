# 이 파일을 .env 로 복사해 채운다. .env 는 커밋하지 않는다.

# 앱 서버 주소. 끝에 슬래시를 붙인다.
#   Android 에뮬레이터  http://10.0.2.2:8000/
#   iOS 시뮬레이터      http://localhost:8000/
#   실기기              개발 머신의 LAN 주소. 같은 와이파이에 있어야 한다
API_BASE_URL=http://10.0.2.2:8000/

# 호출어 감지를 켤지. 끄면 화면의 호출 상태 칩으로 대화를 시작한다.
# 기기에서 감지기가 문제를 일으킬 때 원인을 가르는 스위치이기도 하다.
WAKE_WORD_ENABLED=true

# 카카오 로그인. developers.kakao.com 의 앱 설정 > 요약 정보에 있는
# **네이티브 앱 키**다(REST API 키가 아니다).
#
# 같은 앱에 Android 플랫폼을 등록하고 패키지명과 키해시를 넣어야 동작한다.
#   패키지명   com.pisocake.today_meal
#   키해시     keytool -exportcert -alias androiddebugkey \
#                -keystore ~/.android/debug.keystore -storepass android \
#              | openssl sha1 -binary | openssl base64
#
# WARNING: 이 키는 앱 안에 들어가므로 완전한 비밀이 아니다. 키만으로는 계정에
# 들어갈 수 없다 — 서버가 카카오에 직접 토큰을 물어 확인한다.
# 비워 두면 카카오 로그인 버튼이 "준비 중" 으로 동작한다.
KAKAO_NATIVE_APP_KEY=
