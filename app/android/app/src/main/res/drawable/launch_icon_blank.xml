<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 부터 시스템이 강제로 띄우는 스플래시의 아이콘 자리.

  비워 두는 이유는 **우리 스플래시를 한 번만 보여주기 위해서다.** 시스템이 앱 아이콘을
  띄우고 곧바로 우리 스플래시가 같은 캐릭터를 다시 띄우면 같은 그림이 두 번 튄다.
  배경색만 남기면 시스템 구간이 우리 스플래시의 배경과 이어져 한 화면으로 보인다.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
