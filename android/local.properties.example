# 이 파일을 local.properties 로 복사해 채운다. local.properties 는 커밋하지 않는다.

sdk.dir=/Users/<이름>/Library/Android/sdk

# Porcupine AccessKey. 콘솔에서 발급한다. 소스 저장소에 넣지 않는다.
# WARNING: APK 안의 자격정보는 완전히 비밀이 아니다. 공개 배포 시 관리 방식을 다시 검토한다.
porcupine.accessKey=

# 앱 서버 주소. 개발서버 또는 같은 네트워크의 로컬 머신.
# 끝에 슬래시를 붙인다. Retrofit baseUrl 요구사항이다.
todayMeal.apiBaseUrl=http://10.0.2.2:8000/
