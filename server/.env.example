# 실제 값은 .env 에 두고 커밋하지 않는다.
TODAY_MEAL_ENV=local
TODAY_MEAL_LOG_LEVEL=DEBUG

# PostgreSQL 16. docker-compose 의 서비스명과 맞춘다.
# WARNING: 호스트에 이미 PostgreSQL 이 돌면 5432 가 겹친다. 컨테이너는 5433 으로 노출하고
# 앱은 그 포트로 붙는다. 컨테이너끼리는 db:5432 를 쓴다.
TODAY_MEAL_DB_HOST=localhost
TODAY_MEAL_DB_PORT=5433
TODAY_MEAL_DB_HOST_PORT=5433
TODAY_MEAL_DB_NAME=today_meal
TODAY_MEAL_DB_USER=today_meal
TODAY_MEAL_DB_PASSWORD=change-me

# Gemini. 명령 해석과 영상 분석에 같은 키를 쓴다.
TODAY_MEAL_GEMINI_API_KEY=
# config.py 및 compose 기본값과 맞춘다. 실제 계정의 모델 접근 권한은 별도 확인한다.
TODAY_MEAL_GEMINI_MODEL=gemini-3.8-flash

# 추가 범위. 없어도 필수 기능은 동작한다.
TODAY_MEAL_YOUTUBE_API_KEY=
